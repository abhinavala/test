// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ExportFormat {
  PDF
  MARKDOWN
  HTML
  JSON

  @@map("export_format")
}

model ExportHistory {
  id          String       @id @default(cuid())
  sessionId   String
  format      ExportFormat
  content     String
  contentHash String
  createdAt   DateTime     @default(now())

  @@unique([sessionId, format])
  @@index([sessionId])
  @@index([createdAt])
  @@map("export_history")
}

model SpeakerStatsRecord {
  id        String   @id @default(cuid())
  sessionId String   @unique
  stats     String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([sessionId])
  @@map("speaker_stats")
}

model MeetingSessionSummary {
  id               String         @id @default(cuid())
  meetingSessionId String         @unique
  generatedAt      DateTime       @default(now())
  generatedBy      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now())
  keyDecisions     KeyDecision[]
  openQuestions    OpenQuestion[]
  nextSteps        NextStep[]

  @@index([meetingSessionId])
  @@map("meeting_session_summaries")
}

model KeyDecision {
  id           String               @id @default(cuid())
  summaryId    String
  description  String
  participants String
  madeAt       DateTime?
  context      String?
  summary      MeetingSessionSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId])
  @@map("key_decisions")
}

model OpenQuestion {
  id        String               @id @default(cuid())
  summaryId String
  question  String
  ownerId   String?
  raisedBy  String?
  context   String?
  summary   MeetingSessionSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId])
  @@map("open_questions")
}

enum NextStepPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("next_step_priority")
}

model NextStep {
  id           String               @id @default(cuid())
  summaryId    String
  description  String
  assigneeId   String?
  assigneeName String?
  priority     NextStepPriority     @default(MEDIUM)
  dueDate      DateTime?
  summary      MeetingSessionSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId])
  @@map("next_steps")
}

model ParticipantEngagementScore {
  id             String   @id @default(cuid())
  sessionId      String
  participantId  String
  score          Float
  talkTimeRatio  Float
  questionCount  Int
  responseRate   Float
  sentimentScore Float
  calculatedAt   DateTime @default(now())

  @@unique([sessionId, participantId])
  @@index([sessionId])
  @@index([participantId])
  @@index([calculatedAt])
  @@map("participant_engagement_scores")
}
